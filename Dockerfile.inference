ARG VITROFLOW_INFERENCE_PLATFORM=linux/arm64
FROM --platform=${VITROFLOW_INFERENCE_PLATFORM} ghcr.io/astral-sh/uv:0.12.5-python3.12-trixie-slim

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=8080 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VITROFLOW_INFERENCE_WORK_DIR=/tmp/vitroflow-inference

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --locked --no-dev --extra yolo

EXPOSE 8080

CMD ["vitroflow-inference-worker"]
