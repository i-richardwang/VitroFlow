{
  "$id": "https://vitroflow.local/contracts/annotation-tool-submit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "taskId",
    "proposalId"
  ],
  "additionalProperties": false
}
