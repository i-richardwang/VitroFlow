{
  "$id": "https://vitroflow.local/contracts/annotation-assignment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "input": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "class",
              "bbox"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "coreSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "halo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "displayScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "classes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "rules": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "coreSize",
        "halo",
        "displayScale",
        "classes",
        "rules"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "string",
      "enum": [
        "pi",
        "antigravity"
      ]
    }
  },
  "required": [
    "id",
    "image",
    "input",
    "config",
    "runtime"
  ],
  "additionalProperties": false
}
