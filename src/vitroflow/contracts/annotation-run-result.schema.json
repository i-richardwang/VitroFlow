{
  "$id": "https://vitroflow.local/contracts/annotation-run-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "digest",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "class",
              "bbox"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "image",
        "instances"
      ],
      "additionalProperties": false
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpointDigests": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "issues": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "bbox",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "uncertainIds": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "pi",
            "antigravity"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "runtime",
        "version",
        "model",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document",
    "packageId",
    "checkpointDigests",
    "issues",
    "warnings",
    "uncertainIds",
    "execution"
  ],
  "additionalProperties": false
}
