{
  "$id": "https://vitroflow.local/contracts/annotation-tool-preview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "box_2d": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "uncertain": {
            "default": false,
            "type": "boolean"
          },
          "truncated": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "class",
          "box_2d"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "default": [],
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "box_2d": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "box_2d",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "taskId",
    "instances"
  ],
  "additionalProperties": false
}
