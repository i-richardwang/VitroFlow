{
  "$id": "https://vitroflow.local/contracts/inference-assignment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "modelVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "classes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "artifact": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "traditional"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "kind",
                "digest"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "ultralytics"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "weights": {
                  "type": "object",
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "digest",
                    "bytes"
                  ],
                  "additionalProperties": false
                },
                "inference": {
                  "type": "object",
                  "properties": {
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "imageSize": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxDetections": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endToEnd": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "confidence",
                    "imageSize",
                    "maxDetections",
                    "endToEnd"
                  ],
                  "additionalProperties": false
                },
                "validation": {
                  "type": "object",
                  "properties": {
                    "precision": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "recall": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "map50": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "map50To95": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fitness": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "precision",
                    "recall",
                    "map50",
                    "map50To95",
                    "fitness"
                  ],
                  "additionalProperties": false
                },
                "training": {
                  "type": "object",
                  "properties": {
                    "baseModel": {
                      "type": "object",
                      "properties": {
                        "reference": {
                          "type": "string",
                          "minLength": 1
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "reference",
                        "digest"
                      ],
                      "additionalProperties": false
                    },
                    "parameters": {
                      "type": "object",
                      "properties": {
                        "epochs": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 300
                        },
                        "patience": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 300
                        },
                        "batch": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 64
                        },
                        "imgsz": {
                          "type": "integer",
                          "minimum": 320,
                          "maximum": 2048,
                          "multipleOf": 32
                        },
                        "optimizer": {
                          "type": "string",
                          "enum": [
                            "auto",
                            "SGD",
                            "Adam",
                            "AdamW",
                            "NAdam",
                            "RAdam",
                            "RMSProp"
                          ]
                        },
                        "lr0": {
                          "type": "number",
                          "minimum": 0.00001,
                          "maximum": 0.1
                        },
                        "warmup_epochs": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 10
                        },
                        "mosaic": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "mixup": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "copy_paste": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "max_det": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "seed": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "deterministic": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "epochs",
                        "patience",
                        "batch",
                        "imgsz",
                        "optimizer",
                        "lr0",
                        "warmup_epochs",
                        "mosaic",
                        "mixup",
                        "copy_paste",
                        "max_det",
                        "seed",
                        "deterministic"
                      ],
                      "additionalProperties": false
                    },
                    "runtime": {
                      "type": "object",
                      "properties": {
                        "framework": {
                          "type": "string",
                          "const": "ultralytics"
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "framework",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "baseModel",
                    "parameters",
                    "runtime"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "digest",
                "weights",
                "inference",
                "validation",
                "training"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "modelVersionId",
        "classes",
        "artifact"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "leaseExpiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "manifest",
    "image",
    "leaseExpiresAt"
  ],
  "additionalProperties": false
}
