{
  "$id": "https://vitroflow.local/contracts/annotation-job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "pi",
        "antigravity"
      ]
    }
  },
  "required": [
    "id",
    "runtime"
  ],
  "additionalProperties": false
}
