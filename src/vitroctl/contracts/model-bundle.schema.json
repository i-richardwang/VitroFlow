{
  "$id": "https://vitroflow.local/contracts/model-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "classes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "weights": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 536870912
        }
      },
      "required": [
        "digest",
        "bytes"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "imageSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "maxDetections": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "endToEnd": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "const": "whole_image"
        },
        "iou": {
          "type": "number",
          "const": 0.7
        }
      },
      "required": [
        "confidence",
        "imageSize",
        "maxDetections",
        "endToEnd",
        "mode",
        "iou"
      ],
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "properties": {
        "baseModel": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reference",
            "digest"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "epochs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "patience": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "batch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "nbs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "imgsz": {
              "type": "integer",
              "minimum": 320,
              "maximum": 2048,
              "multipleOf": 32
            },
            "optimizer": {
              "type": "string",
              "enum": [
                "auto",
                "SGD",
                "Adam",
                "AdamW",
                "NAdam",
                "RAdam",
                "RMSProp"
              ]
            },
            "lr0": {
              "type": "number",
              "minimum": 0.00001,
              "maximum": 0.1
            },
            "warmup_epochs": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "mosaic": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "mixup": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "copy_paste": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_det": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deterministic": {
              "type": "boolean"
            },
            "scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "flipud": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fliplr": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "translate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hsv_h": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hsv_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hsv_v": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "epochs",
            "patience",
            "batch",
            "imgsz",
            "optimizer",
            "lr0",
            "warmup_epochs",
            "mosaic",
            "mixup",
            "copy_paste",
            "max_det",
            "seed",
            "deterministic"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "framework": {
              "type": "string",
              "const": "ultralytics"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "framework",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseModel",
        "parameters",
        "runtime"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "map50": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "map50To95": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fitness": {
          "type": "number"
        }
      },
      "required": [
        "precision",
        "recall",
        "map50",
        "map50To95",
        "fitness"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshotId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "fingerprint",
            "snapshotId",
            "description"
          ],
          "additionalProperties": false
        },
        "selectedEpoch": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "codeRevision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveParameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "calibration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "metrics": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "description",
            "calibration",
            "metrics"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dataset",
        "selectedEpoch",
        "codeRevision",
        "effectiveParameters",
        "evaluation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "classes",
    "weights",
    "inference",
    "training",
    "validation",
    "provenance"
  ],
  "additionalProperties": false
}
