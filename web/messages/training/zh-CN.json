  "train_dialog_recipe": "{model} · {framework} {version}",
  "run_epochs_progress": [
    {
      "declarations": [
        "input completed",
        "input total",
        "local formattedCompleted = completed: number",
        "local formattedTotal = total: number"
      ],
      "match": {
        "completed=*": "{formattedCompleted} / {formattedTotal}"
      }
    }
  ],
  "train_dialog_recipe_title": "配方",
