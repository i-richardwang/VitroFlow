  "ui_drop_zone_remove": "移除 {file}",
  "ui_file_size_bytes": [
    {
      "declarations": [
        "input bytes",
        "local formatted = bytes: number maximumFractionDigits=0"
      ],
      "match": {
        "formatted=*": "{formatted} B"
      }
    }
  ],
  "ui_file_size_kib": [
    {
      "declarations": [
        "input kibibytes",
        "local formatted = kibibytes: number maximumFractionDigits=0"
      ],
      "match": {
        "formatted=*": "{formatted} KiB"
      }
    }
  ],
  "ui_file_size_mib": [
    {
      "declarations": [
        "input mebibytes",
        "local formatted = mebibytes: number maximumFractionDigits=1"
      ],
      "match": {
        "formatted=*": "{formatted} MiB"
      }
    }
  ],
  "ui_input_hide_password": "隐藏密码",
  "ui_input_number_decrease": "减少",
