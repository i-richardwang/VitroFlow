{
  "name": "vitroflow-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun x vite dev",
    "build": "bun scripts/build.ts",
    "i18n:compile": "bun scripts/compile-messages.ts",
    "start": "bun dist/server.js",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "contracts:generate": "bun scripts/generate-contracts.ts",
    "contracts:check": "bun scripts/generate-contracts.ts --check",
    "blobs:collect": "bun scripts/collect-blobs.ts",
    "maintenance": "bun dist/maintenance.js",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"messages/**/*.json\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" \"messages/**/*.json\"",
    "architecture:check": "bun scripts/check-architecture.ts",
    "lint": "biome lint --error-on-warnings",
    "images:analyze": "bun dist/analyze-images.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@internationalized/date": "^3.12.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@techstark/opencv-js": "4.12.0-release.1",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
