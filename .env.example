# Workbench
DATABASE_URL=postgres://vitroflow:vitroflow@localhost:5432/vitroflow
# The S3-compatible bucket holding image and model bytes.
VITROFLOW_BLOB_ENDPOINT=http://localhost:9000
VITROFLOW_BLOB_BUCKET=vitroflow
AWS_ACCESS_KEY_ID=vitroflow
AWS_SECRET_ACCESS_KEY=vitroflow
AWS_REGION=us-east-1
VITROFLOW_PASSWORD=
VITROFLOW_INFERENCE_WORKER_TOKEN=
VITROFLOW_TRAINING_WORKER_TOKEN=
VITROFLOW_EXPORT_TOKEN=

# Optional default for `vitroflow dataset pull`
VITROFLOW_SERVER_URL=http://localhost:3000
