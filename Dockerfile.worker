FROM --platform=linux/arm64 ghcr.io/astral-sh/uv:0.12.5-python3.12-trixie-slim

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=8080 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VITROFLOW_WORK_DIR=/tmp/vitroflow

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --locked --no-dev

EXPOSE 8080

CMD ["vitroflow-worker"]
