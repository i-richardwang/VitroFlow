FROM ghcr.io/astral-sh/uv:0.12.5-python3.12-trixie-slim

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=8080 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    VITROFLOW_TRAINING_WORK_DIR=/tmp/vitroflow-training \
    VITROFLOW_TRAINING_CONFIG_ROOT=/app/configs/yolo26

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY configs ./configs
COPY src ./src
RUN uv sync --locked --no-dev --group yolo

EXPOSE 8080

CMD ["vitroflow-training-worker"]
