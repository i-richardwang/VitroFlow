FROM oven/bun:1 AS build
WORKDIR /app/web
COPY web/package.json web/bun.lock ./
ENV CI=true
RUN bun install --frozen-lockfile
RUN --mount=type=secret,id=heroui_key \
    HEROUI_KEY="$(cat /run/secrets/heroui_key)" \
    bunx hpsetup@latest react --auto
COPY web .
COPY configs /app/configs
RUN bun run build

FROM oven/bun:1-slim
WORKDIR /app/web
ENV NODE_ENV=production
ENV VITROFLOW_DATA_ROOT=/data
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile --production
COPY --from=build /app/web/node_modules/@heroui-pro/react ./node_modules/@heroui-pro/react
COPY --from=build /app/web/dist ./dist
COPY web/server.ts ./
COPY web/drizzle ./drizzle
EXPOSE 3000
CMD ["bun", "server.ts"]
